{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["lint", "typecheck", "build", "test:unit"],
    "full": ["lint", "typecheck", "build", "test:unit", "test:integration", "test:e2e"]
  },
  "requiredCapabilities": ["lint", "typecheck", "build", "test:unit"],
  "optionalCapabilities": ["test:integration", "test:e2e"],
  "capabilityCommands": {
    ".": {
      "lint": ["bun", "run", "lint"],
      "typecheck": ["bun", "run", "typecheck"],
      "build": ["bun", "run", "build"],
      "test:unit": ["bun", "run", "test:unit"],
      "test:integration": ["bun", "run", "test:integration"],
      "test:e2e": ["bun", "run", "test:e2e"]
    }
  },
  "merge": {
    "authority": "hosted",
    "requiredChecks": ["validate / validate"]
  },
  "conventionRefs": ["PRINCIPLE-001", "REP-002", "PRINCIPLE-003", "TEMPLATE-003", "TEMPLATE-004"]
}
