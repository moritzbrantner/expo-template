{
  "cli": {
    "version": "23.2.0",
    "requireCommit": true
  },
  "build": {
    "development": {
      "bun": "1.3.12",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "bun": "1.3.12",
      "distribution": "internal"
    },
    "direct": {
      "bun": "1.3.12",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "bun": "1.3.12",
      "autoIncrement": true
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {}
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
