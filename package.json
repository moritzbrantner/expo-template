{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "services/auth-api"
  ],
  "scripts": {
    "start": "expo start",
    "reset-project": "bun ./scripts/reset-project.ts",
    "android": "expo start --android",
    "ios": "expo start --ios --port 4002",
    "web": "expo start --web --port 4002",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "dev": "expo start --port 4002",
    "dev:api:up": "docker compose up -d dev-api",
    "dev:api:down": "docker compose stop dev-api",
    "dev:auth:up": "bun ./scripts/start-local-auth.ts",
    "dev:auth:down": "docker compose stop auth-api mailpit",
    "build": "expo export --platform web",
    "test": "bun test ./tests",
    "test:unit": "bun test ./tests/unit.test.ts",
    "test:integration": "bun test ./tests/integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:services:up": "docker compose up -d",
    "test:e2e:services:rebuild": "docker compose up -d --build",
    "test:e2e:services:down": "docker compose down -v"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.99.2",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "jpeg-js": "0.4.4",
    "motion": "^12.38.0",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "1.3.12",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "~19.2.14",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
