import { {% if navigation == 'tabs' %}Tabs{% else %}Stack{% endif %} } from 'expo-router';
import { DarkTheme, DefaultTheme, ThemeProvider } from 'expo-router/react-navigation';
import { StatusBar } from 'expo-status-bar';
import { useColorScheme } from 'react-native';

import { AppProviders } from '../core/app-providers';
import { usePreferences } from '../core/preferences/preferences-provider';

const homeOptions = { title: 'Home', headerShown: false } as const;
{% if navigation == 'tabs' %}const settingsOptions = { title: 'Settings' } as const;
const stopwatchOptions = { title: 'Stopwatch' } as const;
{% if profile == 'scheduled' %}const reminderOptions = { title: 'Reminder' } as const;
{% endif %}{% if profile == 'account-backed' %}const hiddenRouteOptions = { href: null } as const;
{% endif %}
{% endif %}export default function RootLayout() {
  return (
    <AppProviders>
      <RootNavigator />
    </AppProviders>
  );
}

function RootNavigator() {
  const systemScheme = useColorScheme();
  const { preferences } = usePreferences();
  const scheme = preferences.themeMode === 'system' ? systemScheme : preferences.themeMode;

  return (
    <ThemeProvider value={scheme === 'dark' ? DarkTheme : DefaultTheme}>
{% if navigation == 'tabs' %}      <Tabs>
        <Tabs.Screen name="index" options={homeOptions} />
        <Tabs.Screen name="settings" options={settingsOptions} />
        <Tabs.Screen name="stopwatch" options={stopwatchOptions} />
{% if profile == 'scheduled' %}        <Tabs.Screen name="reminder" options={reminderOptions} />
{% endif %}{% if profile == 'account-backed' %}        <Tabs.Screen name="sign-in" options={hiddenRouteOptions} />
{% endif %}      </Tabs>
{% else %}      <Stack>
        <Stack.Screen name="index" options={homeOptions} />
      </Stack>
{% endif %}      <StatusBar style="auto" />
    </ThemeProvider>
  );
}
