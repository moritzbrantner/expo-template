{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "services/auth-api"
  ],
  "scripts": {
    "start": "expo start",
    "reset-project": "bun ./scripts/reset-project.ts",
    "android": "expo start --android",
    "ios": "expo start --ios --port 4002",
    "web": "expo start --web --port 4002",
    "lint": "expo lint",
    "dev": "expo start --port 4002",
    "dev:api:up": "docker compose up -d dev-api",
    "dev:api:down": "docker compose stop dev-api",
    "build": "expo export --platform web",
    "test": "bun test ./tests",
    "test:unit": "bun test ./tests/unit.test.ts",
    "test:integration": "bun test ./tests/integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:services:up": "docker compose up -d",
    "test:e2e:services:rebuild": "docker compose up -d --build",
    "test:e2e:services:down": "docker compose down -v"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "3.0.2",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/elements": "^2.9.14",
    "@react-navigation/native": "^7.2.2",
    "@tanstack/react-query": "^5.99.2",
    "expo": "~55.0.15",
    "expo-constants": "~55.0.14",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.8",
    "expo-image-manipulator": "~55.0.15",
    "expo-image-picker": "~55.0.18",
    "expo-linking": "~55.0.13",
    "expo-router": "~55.0.12",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "motion": "^12.38.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-native": "0.85.2",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "~19.2.14",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "playwright": "^1.59.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
