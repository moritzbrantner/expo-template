# Local auth API used by the Expo app. Web and the iOS simulator can use localhost.
# Android emulator: use http://10.0.2.2:4401. Physical devices: use the host machine's LAN IP.
EXPO_PUBLIC_AUTH_API_URL=http://localhost:4401

# Local-only starter account created by `bun run dev:auth:up`.
# These are development fixture credentials, not production secrets.
AUTH_STARTER_EMAIL=admin@example.test
AUTH_STARTER_PASSWORD=expo-template-local
AUTH_STARTER_USERNAME=starter_admin
AUTH_STARTER_DISPLAY_NAME=Expo Template Admin

MONOREPO_SUBTREE_DISPATCH_TOKEN=
