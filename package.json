{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "services/auth-api"
  ],
  "scripts": {
    "start": "expo start",
    "reset-project": "bun ./scripts/reset-project.ts",
    "android": "expo start --android",
    "ios": "expo start --ios --port 4002",
    "web": "expo start --web --port 4002",
    "lint": "expo lint",
    "dev": "expo start --port 4002",
    "dev:api:up": "docker compose up -d dev-api",
    "dev:api:down": "docker compose stop dev-api",
    "build": "expo export --platform web",
    "test": "bun test ./tests",
    "test:unit": "bun test ./tests/unit.test.ts",
    "test:integration": "bun test ./tests/integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:services:up": "docker compose up -d",
    "test:e2e:services:rebuild": "docker compose up -d --build",
    "test:e2e:services:down": "docker compose down -v"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.99.0",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~55.0.15",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "motion": "^12.35.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "~19.1.17",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "playwright": "^1.58.2",
    "typescript": "~5.9.3"
  },
  "private": true,
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
